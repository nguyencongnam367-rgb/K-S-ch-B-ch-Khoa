<section class="book-detail-shell">
  <div class="book-detail-shell__topbar">
    <div class="crumbs">
      <a href="/">Trang chủ</a>
      <span>›</span>
      <%= book.category %>
      <span>›</span>
      <strong><%= book.title %></strong>
    </div>
    <a class="book-detail-search" href="/" aria-label="Quay lại danh sách sách">
      <span class="book-detail-search__icon" aria-hidden="true">←</span>
      <span>Quay lại kết quả</span>
    </a>
  </div>

  <div class="book-detail-content">
    <div class="book-detail-cover-wrap">
      <div class="book-detail-cover">
        <% book.coverLines.forEach(function (line) { %>
          <span><%= line %></span>
        <% }); %>
        <small><%= book.author %></small>
      </div>
    </div>

    <div class="book-detail-info">
      <div class="book-detail-label"><%= book.type %></div>
      <h1>
        <%= book.title %>
        <% if (book.subtitle) { %><span>– <%= book.subtitle %></span><% } %>
      </h1>

      <p class="book-detail-description"><%= book.description %></p>

      <dl class="book-detail-meta">
        <div>
          <dt>ISBN</dt>
          <dd><%= book.isbn %></dd>
        </div>
        <div>
          <dt>Tác giả</dt>
          <dd><%= book.author %></dd>
        </div>
        <div>
          <dt>Thể loại</dt>
          <dd><%= book.category %></dd>
        </div>
        <div>
          <dt>Nhà xuất bản</dt>
          <dd><%= book.publisher %></dd>
        </div>
        <div>
          <dt>Ngôn ngữ</dt>
          <dd><%= book.language %></dd>
        </div>
        <div>
          <dt>Năm - Số trang</dt>
          <dd><%= book.pages %></dd>
        </div>
      </dl>
    </div>
  </div>

  <section class="book-detail-section">
    <div class="book-detail-section__header">
      <h2>Nội dung sách</h2>
      <span><%= book.chapters.length %> chương</span>
    </div>

    <ol class="book-detail-chapters">
      <% book.chapters.forEach(function (chapter, index) { %>
        <li>
          <span class="chapter-index"><%= String(index + 1).padStart(2, '0') %></span>
          <span class="chapter-title"><%= chapter.title %></span>
          <span class="chapter-pages">tr. <%= chapter.page %></span>
        </li>
      <% }); %>
    </ol>
  </section>

  <div class="scroll-indicator" aria-hidden="true">↓</div>
</section>
