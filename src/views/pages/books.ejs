<section class="books-view">
  <form class="books-filter" method="get" action="/books" role="search">
    <div class="books-filter__top">
      <h1>Khám phá <em>sách</em></h1>
      <div class="books-filter__search">
        <%- include('../components/input', { id: 'q', name: 'q', type: 'search', value: query.q || '', placeholder: 'Tên sách, tác giả, ISBN, thể loại', autocomplete: 'off' }) %>
        <%- include('../components/button', { type: 'submit', variant: 'primary', label: 'Tìm sách' }) %>
      </div>
    </div>

    <div class="books-filter__row">
      <label class="field">
        <span class="field__label">Thể loại</span>
        <select class="form-input" name="category" data-autosubmit>
          <option value="">Tất cả</option>
          <% categories.forEach(function (item) { %><option value="<%= item.id %>"<%- query.category === item.id ? ' selected' : '' %>><%= item.name %></option><% }); %>
        </select>
      </label>
      <label class="field">
        <span class="field__label">Tác giả</span>
        <select class="form-input" name="author" data-autosubmit>
          <option value="">Tất cả</option>
          <% authors.forEach(function (item) { %><option value="<%= item.id %>"<%- query.author === item.id ? ' selected' : '' %>><%= item.name %></option><% }); %>
        </select>
      </label>
      <label class="field">
        <span class="field__label">Nhà xuất bản</span>
        <select class="form-input" name="publisher" data-autosubmit>
          <option value="">Tất cả</option>
          <% publishers.forEach(function (item) { %><option value="<%= item %>"<%- query.publisher === item ? ' selected' : '' %>><%= item %></option><% }); %>
        </select>
      </label>
      <label class="field">
        <span class="field__label">Ngôn ngữ</span>
        <select class="form-input" name="language" data-autosubmit>
          <option value="">Tất cả</option>
          <% languages.forEach(function (item) { %><option value="<%= item.code %>"<%- query.language === item.code ? ' selected' : '' %>><%= item.label %></option><% }); %>
        </select>
      </label>
      <label class="books-filter__check">
        <input type="checkbox" name="available" value="true"<%- query.available === 'true' ? ' checked' : '' %> data-autosubmit>
        <span>Chỉ sách còn bản</span>
      </label>
    </div>
  </form>

  <div class="books-result">
    <p class="books-result__summary">
      <%= total %> đầu sách
      <% activeFilters.forEach(function (filter) { %> · <%= filter.label %>: <strong><%= filter.value %></strong><% }); %>
      <% if (activeFilters.length || query.q || query.available) { %> · <a href="/books">Xóa bộ lọc</a><% } %>
    </p>

    <% if (books.length) { %>
      <div class="library-book-grid books-grid">
        <% books.forEach(function (book) { %>
          <%- include('../components/book-card', { book: book, showDescription: true }) %>
        <% }); %>
      </div>
    <% } else { %>
      <p class="book-grid__empty">Không tìm thấy sách phù hợp.</p>
    <% } %>

    <%- include('../components/pagination', { pager: pager, noun: 'đầu sách' }) %>
  </div>
</section>
