<article
  id="book-<%= book.id %>"
  class="book-card"
  data-book-card
  data-title="<%= book.title %>"
  data-author="<%= book.author %>"
  data-category="<%= book.category %>"
>
  <div class="book-card__cover book-card__cover--<%= book.accent || 'gold' %>">
    <span><%= book.short || book.title.slice(0, 2).toUpperCase() %></span>
  </div>

  <div class="book-card__content">
    <div class="book-card__meta">
      <span><%= book.category %></span>
      <span>★ <%= book.rating %></span>
    </div>

    <h3><%= book.title %></h3>
    <p class="book-card__author"><%= book.author %></p>
    <p class="book-card__description"><%= book.description %></p>

    <div class="book-card__footer">
      <span class="book-card__price"><%= book.price %></span>
      <a class="button button--secondary" href="/books/<%= book.id %>">Chi tiết</a>
    </div>
  </div>
</article>
