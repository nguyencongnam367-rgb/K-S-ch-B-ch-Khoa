<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f8f6f0">
    <title><%= title %> | Thư viện BK</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/tokens.css">
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/components/button.css">
    <link rel="stylesheet" href="/css/components/input.css">
    <% if (typeof pageStyles !== 'undefined' && pageStyles) { pageStyles.forEach(function (style) { %>
      <link rel="stylesheet" href="<%= style %>">
    <% }); } %>
  </head>
  <body class="<%= pageClass || '' %>">
    <% if (showHeader) { %>
      <%- include('../components/header') %>
    <% } %>
    <main>
      <%- include('../' + page) %>
    </main>
    <% if (showFooter) { %>
      <%- include('../components/footer') %>
    <% } %>
    <% if (typeof pageScripts !== 'undefined' && pageScripts) { pageScripts.forEach(function (script) { %>
      <script src="<%= script %>" defer></script>
    <% }); } %>
  </body>
</html>
