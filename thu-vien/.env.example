PORT=3000
# Chuỗi kết nối MongoDB (cài cục bộ hoặc MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/thu-vien
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@gmail.com
# Development only. Use a private password with at least 12 characters in production.
ADMIN_PASSWORD=123456

# Quy định mượn trả (có thể bỏ qua, đã có giá trị mặc định)
# LOAN_LIMIT=5          # số sách tối đa mỗi độc giả được giữ
# LOAN_DAYS=14          # số ngày được mượn
# FINE_PER_DAY=1500     # tiền phạt mỗi cuốn mỗi ngày quá hạn (đồng)
# FINE_VALUE_RATE=0.01  # hệ số theo giá trị sách (1% tổng giá trị phiếu)

# Gửi email nhắc hạn (bỏ trống thì chỉ ghi ra console)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Thư viện BK <no-reply@bk.edu.vn>"
