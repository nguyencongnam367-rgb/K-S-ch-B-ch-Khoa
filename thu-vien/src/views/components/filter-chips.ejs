<%# Nhóm nút lọc: groupName, chips [{ key, label, count?, tone?, href? }], active (key đang chọn).
    Có href thì là liên kết (lọc phía máy chủ), không có thì là nút (lọc phía trình duyệt). %>
<%
  const chipList = Array.isArray(chips) ? chips : [];
  const chipActive = typeof active === 'string' ? active : (chipList[0] ? chipList[0].key : '');
%>
<div class="chip-group" role="group" aria-label="<%= typeof groupLabel === 'string' ? groupLabel : 'Bộ lọc' %>" data-chip-group="<%= groupName %>">
  <% chipList.forEach(function (chip) {
       const cls = 'chip' + (chip.key === chipActive ? ' is-active' : '') + (chip.tone === 'danger' ? ' chip--danger' : ''); %>
    <% if (chip.href) { %>
      <a class="<%= cls %>" href="<%= chip.href %>"<%- chip.key === chipActive ? ' aria-current="true"' : '' %>>
        <%= chip.label %><% if (chip.count !== undefined) { %> <%= chip.count %><% } %>
      </a>
    <% } else { %>
      <button class="<%= cls %>" type="button" data-value="<%= chip.key %>" aria-pressed="<%= chip.key === chipActive %>">
        <%= chip.label %><% if (chip.count !== undefined) { %> <%= chip.count %><% } %>
      </button>
    <% } %>
  <% }); %>
</div>
