<section class="catalog-view">
  <header class="catalog-view__head">
    <span class="catalog-view__kicker">Mục lục thư viện</span>
    <h1>Danh <em>mục</em></h1>
    <p>Chọn một thể loại hoặc tác giả để xem toàn bộ sách liên quan.</p>
  </header>

  <%- include('../components/tabs', {
    tabsName: 'catalog',
    activeTab: activeTab,
    tabItems: [
      { key: 'categories', label: 'Thể loại', count: categories.length },
      { key: 'authors', label: 'Tác giả', count: authors.length }
    ]
  }) %>

  <section class="catalog-panel" id="panel-categories" role="tabpanel" aria-labelledby="tab-categories" data-tab-panel="categories"<%- activeTab === 'categories' ? '' : ' hidden' %>>
    <% categories.forEach(function (item, index) { %>
      <a class="catalog-row" href="/books?category=<%= item.id %>">
        <span class="catalog-row__no"><%= String(index + 1).padStart(2, '0') %></span>
        <span class="catalog-row__text">
          <strong><%= item.name %></strong>
          <% if (item.description) { %><small><%= item.description %></small><% } %>
        </span>
        <span class="catalog-row__count"><%= item.count %></span>
      </a>
    <% }); %>
    <% if (!categories.length) { %><p class="book-grid__empty">Chưa có thể loại nào.</p><% } %>
  </section>

  <section class="catalog-panel" id="panel-authors" role="tabpanel" aria-labelledby="tab-authors" data-tab-panel="authors"<%- activeTab === 'authors' ? '' : ' hidden' %>>
    <% authors.forEach(function (item, index) { %>
      <a class="catalog-row" href="/books?author=<%= item.id %>">
        <span class="catalog-row__no"><%= String(index + 1).padStart(2, '0') %></span>
        <span class="catalog-row__text">
          <strong><%= item.name %></strong>
          <% if (item.description) { %><small><%= item.description %></small><% } %>
        </span>
        <span class="catalog-row__count"><%= item.count %></span>
      </a>
    <% }); %>
    <% if (!authors.length) { %><p class="book-grid__empty">Chưa có tác giả nào.</p><% } %>
  </section>
</section>
