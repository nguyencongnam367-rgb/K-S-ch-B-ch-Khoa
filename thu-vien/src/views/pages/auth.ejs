<div class="auth-shell">
  <a class="auth-brand" href="/">
    <img class="brand-logo" src="/images/logo-bk.png" alt="">
    <span>Thư viện</span>
  </a>

  <section class="auth-card" aria-labelledby="auth-title">
    <p class="auth-kicker">Chào mừng bạn</p>
    <h1 id="auth-title">Tài khoản <em>thư viện</em></h1>
    <p class="auth-intro">Đăng nhập để theo dõi sách đang mượn hoặc tạo tài khoản độc giả.</p>

    <div class="auth-tabs" role="tablist" aria-label="Chọn hình thức">
      <button class="is-active" type="button" role="tab" aria-selected="true" aria-controls="login-panel" data-auth-tab="login">Đăng nhập</button>
      <button type="button" role="tab" aria-selected="false" aria-controls="register-panel" data-auth-tab="register">Đăng ký độc giả</button>
    </div>

    <div id="login-panel" class="auth-panel" role="tabpanel">
      <form id="login-form" data-auth-form="login">
        <label class="field">
          <span class="field__label">Email</span>
          <input class="form-input" type="email" name="email" autocomplete="email" required>
        </label>
        <label class="field">
          <span class="field__label">Mật khẩu</span>
          <input class="form-input" type="password" name="password" autocomplete="current-password" required>
        </label>
        <p class="auth-message" role="alert" hidden></p>
        <button class="button button--primary auth-submit" type="submit">Đăng nhập</button>
      </form>
    </div>

    <div id="register-panel" class="auth-panel" role="tabpanel" hidden>
      <form id="register-form" data-auth-form="register">
        <label class="field">
          <span class="field__label">Họ và tên</span>
          <input class="form-input" type="text" name="name" autocomplete="name" minlength="2" maxlength="80" required>
        </label>
        <label class="field">
          <span class="field__label">Email</span>
          <input class="form-input" type="email" name="email" autocomplete="email" maxlength="254" required>
        </label>
        <label class="field">
          <span class="field__label">Loại độc giả</span>
          <select class="form-input" name="readerType">
            <option value="student">Sinh viên</option>
            <option value="lecturer">Giảng viên</option>
          </select>
        </label>
        <label class="field">
          <span class="field__label">Mật khẩu (ít nhất 6 ký tự)</span>
          <input class="form-input" type="password" name="password" autocomplete="new-password" minlength="6" required>
        </label>
        <label class="field">
          <span class="field__label">Nhập lại mật khẩu</span>
          <input class="form-input" type="password" name="confirmPassword" autocomplete="new-password" minlength="6" required>
        </label>
        <p class="auth-message" role="alert" hidden></p>
        <button class="button button--primary auth-submit" type="submit">Tạo tài khoản</button>
      </form>
    </div>
  </section>
</div>
