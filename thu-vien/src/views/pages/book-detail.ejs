<section class="book-detail-shell" data-book-id="<%= book.id %>">
  <div class="book-detail-shell__topbar">
    <div class="crumbs">
      <a href="/">Trang chủ</a>
      <span>›</span>
      <a href="/books?category=<%= book.category.id %>"><%= book.category.name %></a>
      <span>›</span>
      <strong><%= book.title %></strong>
    </div>
    <a class="book-detail-search" href="/books" aria-label="Quay lại danh sách sách">
      <span class="book-detail-search__icon" aria-hidden="true">←</span>
      <span>Quay lại kết quả</span>
    </a>
  </div>

  <div class="book-detail-content">
    <div class="book-detail-cover-wrap">
      <% if (book.cover) { %>
        <img class="book-detail-cover book-detail-cover--image" src="<%= book.cover %>" alt="Bìa sách <%= book.title %>">
      <% } else { %>
        <div class="book-detail-cover">
          <span><%= book.coverLines[0] %></span>
          <% if (book.coverLines[1]) { %><span><%= book.coverLines[1] %></span><% } %>
          <small><%= book.author.name %></small>
        </div>
      <% } %>
    </div>

    <div class="book-detail-info">
      <h1><%= book.title %></h1>

      <% if (book.description) { %><p class="book-detail-description"><%= book.description %></p><% } %>

      <%# Tác giả, thể loại, nhà xuất bản, ngôn ngữ là liên kết: bấm để xem các sách cùng loại %>
      <dl class="book-detail-meta">
        <div>
          <dt>ISBN</dt>
          <dd><%= book.isbn %></dd>
        </div>
        <div>
          <dt>Tác giả</dt>
          <dd><a class="meta-link" href="/books?author=<%= book.author.id %>"><%= book.author.name %></a></dd>
        </div>
        <div>
          <dt>Thể loại</dt>
          <dd><a class="meta-link" href="/books?category=<%= book.category.id %>"><%= book.category.name %></a></dd>
        </div>
        <% if (book.publisher) { %>
          <div>
            <dt>Nhà xuất bản</dt>
            <dd><a class="meta-link" href="/books?publisher=<%= encodeURIComponent(book.publisher) %>"><%= book.publisher %></a></dd>
          </div>
        <% } %>
        <div>
          <dt>Ngôn ngữ</dt>
          <dd><a class="meta-link" href="/books?language=<%= book.language %>"><%= book.languageLabel %></a></dd>
        </div>
        <% if (book.yearPages) { %>
          <div>
            <dt>Năm · Số trang</dt>
            <dd><%= book.yearPages %></dd>
          </div>
        <% } %>
      </dl>

      <div class="book-detail-actions">
        <% if (user && user.role === 'user') { %>
          <% if (book.activeLoanId) { %>
            <button class="button button--secondary" type="button" data-return-book data-loan-id="<%= book.activeLoanId %>">Trả sách</button>
          <% } else if (book.availableCopies > 0) { %>
            <button class="button button--primary" type="button" data-borrow-book>Mượn sách</button>
          <% } else { %>
            <span class="book-detail-stock book-detail-stock--out">Sách hiện đã hết</span>
          <% } %>
        <% } else if (!user && book.availableCopies > 0) { %>
          <a class="button button--primary" href="/auth?returnTo=<%= encodeURIComponent('/books/' + book.id) %>">Đăng nhập để mượn</a>
        <% } else if (!user) { %>
          <span class="book-detail-stock book-detail-stock--out">Sách hiện đã hết</span>
        <% } %>
        <p class="book-detail-action-message" role="status" aria-live="polite" hidden></p>
      </div>
    </div>
  </div>

  <% if (book.chapters.length) { %>
    <section class="book-detail-section">
      <div class="book-detail-section__header">
        <h2>Nội dung sách</h2>
        <span><%= book.chapters.length %> chương</span>
      </div>

      <ol class="book-detail-chapters">
        <% book.chapters.forEach(function (chapter, index) { %>
          <li>
            <span class="chapter-index"><%= String(index + 1).padStart(2, '0') %></span>
            <span class="chapter-title"><%= chapter.title %></span>
            <span class="chapter-pages"><% if (chapter.page) { %>tr. <%= chapter.page %><% } %></span>
          </li>
        <% }); %>
      </ol>
    </section>
  <% } %>
</section>
