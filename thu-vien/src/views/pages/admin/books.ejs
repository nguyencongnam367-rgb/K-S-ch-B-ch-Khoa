<%- include('../../components/page-heading', {
  titleBefore: 'Quản lý',
  titleEm: 'sách',
  actionLabel: '+ Thêm sách',
  actionAttrs: 'data-toggle="#book-form" aria-controls="book-form" aria-expanded="false"'
}) %>

<%# Biểu mẫu thêm sách đặt ở đầu trang, mở bằng nút "+ Thêm sách". Gửi bằng API POST /api/v1/books %>
<form class="book-form" id="book-form" data-api-form data-api-url="/books" data-api-method="POST" enctype="multipart/form-data" hidden>
  <label class="dropzone" for="book-cover">
    <svg class="dropzone__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V5m0 0-4 4m4-4 4 4M5 19h14"/></svg>
    <span class="dropzone__hint" data-default-hint="Kéo ảnh bìa vào đây (JPG, PNG, tối đa 2 MB)">Kéo ảnh bìa vào đây (JPG, PNG, tối đa 2 MB)</span>
    <input id="book-cover" type="file" name="cover" accept="image/jpeg,image/png,image/webp" hidden data-cover-input>
  </label>

  <div class="book-form__main">
    <div class="form-grid">
      <label class="field">
        <span class="field__label">Tên sách</span>
        <%- include('../../components/input', { id: 'book-title', name: 'title', placeholder: 'Nhập tên sách', required: true }) %>
      </label>
      <label class="field">
        <span class="field__label">Thể loại</span>
        <select class="form-input" name="category" required>
          <option value="">Chọn thể loại</option>
          <% categories.forEach(function (item) { %><option value="<%= item.id %>"><%= item.name %></option><% }); %>
        </select>
      </label>
      <label class="field">
        <span class="field__label">ISBN</span>
        <%- include('../../components/input', { id: 'book-isbn', name: 'isbn', placeholder: '978-604-…', required: true }) %>
      </label>
      <label class="field">
        <span class="field__label">Tổng số bản</span>
        <%- include('../../components/input', { id: 'book-copies', name: 'totalCopies', type: 'number', value: 1, required: true, attrs: 'min="1" inputmode="numeric"' }) %>
      </label>
      <label class="field">
        <span class="field__label">Tác giả</span>
        <select class="form-input" name="author" required>
          <option value="">Chọn tác giả</option>
          <% authors.forEach(function (item) { %><option value="<%= item.id %>"><%= item.name %></option><% }); %>
        </select>
      </label>
      <label class="field">
        <span class="field__label">Nhà xuất bản</span>
        <%- include('../../components/input', { id: 'book-publisher', name: 'publisher', placeholder: 'Không bắt buộc' }) %>
      </label>
      <label class="field book-form__description">
        <span class="field__label">Mô tả sách</span>
        <textarea class="form-input" id="book-description" name="description" rows="5" placeholder="Nhập mô tả về nội dung sách"></textarea>
      </label>
    </div>
    <p class="form-message" data-form-message role="alert" hidden></p>
    <div class="form-actions">
      <%- include('../../components/button', { type: 'submit', variant: 'primary', label: 'Lưu sách' }) %>
      <%- include('../../components/button', { type: 'button', variant: 'ghost', label: 'Hủy', attrs: 'data-toggle="#book-form"' }) %>
    </div>
  </div>
</form>

<%# Tìm kiếm và lọc phía máy chủ: gửi GET, kết quả phân trang từ MongoDB %>
<form class="book-search-form" method="get" action="/admin/books">
  <%- include('../../components/search-row', { id: 'book-search', inputName: 'q', inputValue: query.q || '', placeholder: 'Tìm theo tên, tác giả, ISBN, thể loại' }) %>
  <div class="book-filters">
    <select class="form-input" name="category" aria-label="Lọc theo thể loại" data-autosubmit>
      <option value="">Tất cả thể loại</option>
      <% categories.forEach(function (item) { %><option value="<%= item.id %>"<%- query.category === item.id ? ' selected' : '' %>><%= item.name %></option><% }); %>
    </select>
    <select class="form-input" name="stock" aria-label="Lọc theo số lượng" data-autosubmit>
      <option value="">Tất cả số lượng</option>
      <option value="in"<%- query.stock === 'in' ? ' selected' : '' %>>Còn sách</option>
      <option value="out"<%- query.stock === 'out' ? ' selected' : '' %>>Hết sách</option>
    </select>
  </div>
</form>

<div class="data-head data-row--books" aria-hidden="true">
  <span></span><span>TÊN SÁCH</span><span>TÁC GIẢ</span><span>THỂ LOẠI</span><span>SỐ LƯỢNG</span><span></span>
</div>
<% books.forEach(function (book) { %>
  <div class="data-row data-row--books">
    <% if (book.cover) { %>
      <img class="thumb" src="<%= book.cover %>" alt="">
    <% } else { %>
      <span class="thumb" style="background-color: <%= book.color %>"></span>
    <% } %>
    <span class="data-row__title"><a class="data-row__link" href="/books/<%= book.id %>"><%= book.title %></a></span>
    <span><%= book.author %></span>
    <span><%= book.category %></span>
    <span class="qty qty--<%= book.available > 0 ? 'ok' : 'none' %>"><%= book.available %> / <%= book.total %></span>
    <div class="row-actions">
      <button class="row-action" type="button" data-book-edit="<%= book.id %>" data-title="<%= book.title %>" data-total="<%= book.total %>">Sửa</button>
      <button class="row-action row-action--danger" type="button" data-api-delete="/books/<%= book.id %>" data-confirm="Xóa sách “<%= book.title %>”?">Xóa</button>
    </div>
  </div>
<% }); %>
<% if (!books.length) { %><p class="empty-state">Không tìm thấy sách phù hợp.</p><% } %>

<%- include('../../components/pagination', { pager: pager, noun: 'đầu sách' }) %>
